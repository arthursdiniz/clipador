# Copy to .env for local development. These are example values only.
POSTGRES_DB=clipador
POSTGRES_USER=clipador
POSTGRES_PASSWORD=replace-with-a-local-password
RABBITMQ_USER=clipador
RABBITMQ_PASSWORD=replace-with-a-local-password
CLIPADOR_SECURITY_USERNAME=admin
CLIPADOR_SECURITY_PASSWORD=replace-with-a-local-password
CLIPADOR_API_DOCS_PUBLIC=true
CLIPADOR_MAX_CONCURRENT_REQUESTS=64
CLIPADOR_MAX_CONCURRENT_UPLOADS=2
CLIPADOR_QUEUE_METRICS_INTERVAL=PT15S
CLIPADOR_STORAGE_ROOT=./data/storage
CLIPADOR_STORAGE_TYPE=local
CLIPADOR_FFMPEG_EXECUTABLE=ffmpeg
CLIPADOR_FFPROBE_EXECUTABLE=ffprobe
CLIPADOR_TEMP_ROOT=./data/tmp
CLIPADOR_MAX_UPLOAD_BYTES=5368709120
CLIPADOR_MAX_VIDEO_DURATION=PT4H
CLIPADOR_MAX_VIDEO_WIDTH=3840
CLIPADOR_MAX_VIDEO_HEIGHT=2160
CLIPADOR_ORPHAN_RETENTION=PT24H
CLIPADOR_RABBIT_RETRY_DELAY_MS=30000
CLIPADOR_WORKER_MAX_RETRIES=5
CLIPADOR_WORKER_TASKS=VALIDATE_MEDIA,EXTRACT_AUDIO,TRANSCRIBE_AUDIO,ANALYZE_CONTENT,RENDER_CLIPS
CLIPADOR_WHISPER_MODEL=small
CLIPADOR_WHISPER_DEVICE=cpu
CLIPADOR_WHISPER_COMPUTE_TYPE=int8
CLIPADOR_WHISPER_BEAM_SIZE=5
CLIPADOR_WHISPER_VAD_MIN_SILENCE_MS=500
CLIPADOR_TRANSCRIPT_MAX_ARTIFACT_BYTES=67108864
CLIPADOR_ANALYSIS_MAX_ARTIFACT_BYTES=16777216
CLIPADOR_ANALYSIS_MAX_CANDIDATES=100
CLIPADOR_CLIP_BASE_COUNT=5
CLIPADOR_CLIP_MINUTES_PER_CLIP=5
CLIPADOR_CLIP_AUTO_MAX=20
CLIPADOR_CLIP_EXTENDED_MULTIPLIER=1.5
CLIPADOR_CLIP_EXTENDED_MIN_EXTRA=3
CLIPADOR_CLIP_MAX_REQUESTED=30
CLIPADOR_CLIP_MIN_DURATION=20
CLIPADOR_CLIP_IDEAL_DURATION=45
CLIPADOR_CLIP_MAX_DURATION=90
CLIPADOR_ANALYSIS_PROVIDER=local
CLIPADOR_OLLAMA_URL=http://127.0.0.1:11434/api/chat
CLIPADOR_OLLAMA_MODEL=qwen3:4b
CLIPADOR_RENDER_FORMATS=VERTICAL_9_16
CLIPADOR_RENDER_BURN_IN_SUBTITLES=true
