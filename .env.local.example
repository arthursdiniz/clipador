# Copy to .env.local when running without containers. Replace every example secret.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:55432/clipador
SPRING_DATASOURCE_USERNAME=clipador
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=clipador
SPRING_RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=clipador
RABBITMQ_PASSWORD=replace-with-a-local-password
CLIPADOR_RABBITMQ_ERLANG_COOKIE=replace-with-a-random-alphanumeric-cookie
CLIPADOR_RABBITMQ_NODE_NAME=clipador@YOUR-COMPUTER-NAME
CLIPADOR_SECURITY_USERNAME=admin
CLIPADOR_SECURITY_PASSWORD=replace-with-a-local-password
CLIPADOR_API_DOCS_PUBLIC=true
CLIPADOR_MAX_CONCURRENT_REQUESTS=64
CLIPADOR_MAX_CONCURRENT_UPLOADS=2
CLIPADOR_QUEUE_METRICS_INTERVAL=PT15S
CLIPADOR_STORAGE_TYPE=local
CLIPADOR_WHISPER_MODEL=small
CLIPADOR_WHISPER_DEVICE=cpu
CLIPADOR_WHISPER_COMPUTE_TYPE=int8
CLIPADOR_WORKER_TASKS=VALIDATE_MEDIA,EXTRACT_AUDIO,TRANSCRIBE_AUDIO,ANALYZE_CONTENT,RENDER_CLIPS
CLIPADOR_CLIP_BASE_COUNT=5
CLIPADOR_CLIP_MINUTES_PER_CLIP=5
CLIPADOR_CLIP_AUTO_MAX=20
CLIPADOR_CLIP_EXTENDED_MULTIPLIER=1.5
CLIPADOR_CLIP_EXTENDED_MIN_EXTRA=3
CLIPADOR_CLIP_MAX_REQUESTED=30
CLIPADOR_CLIP_MIN_DURATION=20
CLIPADOR_CLIP_IDEAL_DURATION=45
CLIPADOR_CLIP_MAX_DURATION=90
CLIPADOR_ANALYSIS_PROVIDER=local
CLIPADOR_OLLAMA_URL=http://127.0.0.1:11434/api/chat
CLIPADOR_OLLAMA_MODEL=qwen3:4b
CLIPADOR_RENDER_FORMATS=VERTICAL_9_16
CLIPADOR_RENDER_BURN_IN_SUBTITLES=true
CLIPADOR_RENDER_VIDEO_CRF=21
CLIPADOR_RENDER_PRESET=medium
CLIPADOR_RENDER_AUDIO_BITRATE_KBPS=160
CLIPADOR_RENDER_OUTPUT_FPS=30
CLIPADOR_RENDER_MAX_OUTPUT_BYTES=2147483648
CLIPADOR_SMART_REFRAMING_ENABLED=true
CLIPADOR_REFRAMING_MODE=AUTO
CLIPADOR_REFRAMING_SAMPLE_FPS=1.5
CLIPADOR_REFRAMING_SMOOTHING=0.82
CLIPADOR_REFRAMING_MAX_PAN_RATIO_PER_SECOND=0.35
CLIPADOR_REFRAMING_FACE_MIN_SIZE_RATIO=0.025
CLIPADOR_REFRAMING_DETECTION_WIDTH=640
CLIPADOR_REFRAMING_MAX_KEYFRAMES=64
